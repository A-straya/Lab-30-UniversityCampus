hostname R2
no ip domain-lookup
service password-encryption
enable secret ChangeMe-SSH-2026
ip domain-name university.local
username netadmin privilege 15 secret ChangeMe-SSH-2026
crypto key generate rsa modulus 1024
ip ssh version 2
!
interface GigabitEthernet0/0
 description CENTRAL_SERVER_LAN
 ip address 192.168.1.1 255.255.255.0
 no shutdown
!
interface Serial0/0/0
 description TO_R1_SERIAL0/0/0
 ip address 10.0.0.1 255.255.255.252
 no shutdown
!
ip dhcp excluded-address 172.16.10.1 172.16.10.20
ip dhcp excluded-address 172.16.20.1 172.16.20.20
ip dhcp excluded-address 172.16.30.1 172.16.30.20
ip dhcp excluded-address 172.16.40.1 172.16.40.20
ip dhcp excluded-address 172.16.50.1 172.16.50.20
ip dhcp excluded-address 172.16.60.1 172.16.60.20
ip dhcp excluded-address 172.16.70.1 172.16.70.20
ip dhcp excluded-address 172.16.80.1 172.16.80.20
ip dhcp excluded-address 172.16.90.1 172.16.90.20
ip dhcp excluded-address 172.16.100.1 172.16.100.20
!
ip dhcp pool VLAN10_ADMIN
 network 172.16.10.0 255.255.255.0
 default-router 172.16.10.1
 dns-server 192.168.1.10
 domain-name university.local
!
ip dhcp pool VLAN20_FINANCE
 network 172.16.20.0 255.255.255.0
 default-router 172.16.20.1
 dns-server 192.168.1.10
 domain-name university.local
!
ip dhcp pool VLAN30_HR
 network 172.16.30.0 255.255.255.0
 default-router 172.16.30.1
 dns-server 192.168.1.10
 domain-name university.local
!
ip dhcp pool VLAN40_COMPUTING
 network 172.16.40.0 255.255.255.0
 default-router 172.16.40.1
 dns-server 192.168.1.10
 domain-name university.local
!
ip dhcp pool VLAN50_ART
 network 172.16.50.0 255.255.255.0
 default-router 172.16.50.1
 dns-server 192.168.1.10
 domain-name university.local
!
ip dhcp pool VLAN60_LAB
 network 172.16.60.0 255.255.255.0
 default-router 172.16.60.1
 dns-server 192.168.1.10
 domain-name university.local
!
ip dhcp pool VLAN70_IT
 network 172.16.70.0 255.255.255.0
 default-router 172.16.70.1
 dns-server 192.168.1.10
 domain-name university.local
!
ip dhcp pool VLAN80_STAFF
 network 172.16.80.0 255.255.255.0
 default-router 172.16.80.1
 dns-server 192.168.1.10
 domain-name university.local
!
ip dhcp pool VLAN90_BUSINESS
 network 172.16.90.0 255.255.255.0
 default-router 172.16.90.1
 dns-server 192.168.1.10
 domain-name university.local
!
ip dhcp pool VLAN100_STUDENT_LAB
 network 172.16.100.0 255.255.255.0
 default-router 172.16.100.1
 dns-server 192.168.1.10
 domain-name university.local
!

router ospf 10
 router-id 2.2.2.2
 passive-interface default
 no passive-interface Serial0/0/0
 network 10.0.0.0 0.0.0.3 area 0
 network 192.168.1.0 0.0.0.255 area 0
!
ip access-list standard VTY-MGMT
 permit 172.16.70.0 0.0.0.255
!
line vty 0 4
 login local
 transport input ssh
 access-class VTY-MGMT in
 exec-timeout 10 0
!
end
write memory
